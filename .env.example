# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for browser SDK (requires Places API (New) + Maps JavaScript API enabled).
# Auto-provisioned by Google Maps setup in AI Studio.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# GOOGLE_MAPS_API_KEY: Optional server-side API key fallback for /api/places-search (recommended when deploying to Vercel if using server-side search fallback).
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_SERVER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
